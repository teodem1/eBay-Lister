# Copy to .env and fill in. Never commit .env.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Which eBay site to search: EBAY_CA (eBay.ca), EBAY_US, EBAY_GB...
EBAY_MARKETPLACE_ID=EBAY_CA
# Claude API key, used to identify items from photos.
ANTHROPIC_API_KEY=

# Android app (Capacitor): the hosted server the APK loads. Used only at build time.
CAP_SERVER_URL=
