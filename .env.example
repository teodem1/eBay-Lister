# Copy to .env and fill in. Never commit .env.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Claude: identifies items from photos and writes the SEO title, item specifics and description
ANTHROPIC_API_KEY=

# eBay seller account (Sell Inventory API needs a USER token, not just app keys).
# Get a refresh token once through eBay's OAuth consent flow with the
# sell.inventory scope. EBAY_USER_TOKEN (a 2-hour access token) also works for quick tests.
EBAY_REFRESH_TOKEN=
# Easiest way to get the refresh token: set EBAY_RUNAME (developer.ebay.com ->
# User Tokens -> "Get a Token from eBay via Your Application" -> your RuName),
# set that RuName's "auth accepted URL" to https://<your host>/api/ebay/callback,
# then open https://<your host>/api/ebay/connect and sign in.
EBAY_RUNAME=
# EBAY_USER_TOKEN is only used when EBAY_REFRESH_TOKEN is empty.
EBAY_USER_TOKEN=
# Which eBay site to search and list on: EBAY_CA (eBay.ca), EBAY_US, EBAY_GB...
EBAY_MARKETPLACE_ID=EBAY_CA
# Optional overrides; defaults follow the marketplace (en-CA / CAD / CA).
EBAY_CONTENT_LANGUAGE=
EBAY_CURRENCY=
# Business policy IDs from your seller account (shipping, payment, returns).
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Promoted Listings Standard: ad rate (% of the sale, 2-100) for every new listing. Empty = off.
EBAY_PROMOTED_PERCENT=11
# Best Offer (no auto-accept): offers under this % of the price are declined automatically (1-99).
# Empty = no Best Offer.
EBAY_BEST_OFFER_MIN_PERCENT=75
# Where items ship from. Created on first publish if it doesn't exist.
# EBAY_LOCATION_POSTAL_CODE is required (e.g. H2X 1Y4).
EBAY_LOCATION_KEY=default-location
EBAY_LOCATION_COUNTRY=CA
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_CITY=

# Optional: sold prices from sold-comps.com (third-party, not eBay) for the
# "Last sold" price, used when eBay hasn't approved Marketplace Insights.
# Free plan: 100 requests/month. https://sold-comps.com
SOLD_COMPS_API_KEY=
# How many days of sales to ask for (30-1095, default 365). eBay's public sold search
# keeps about 90 days, so older sales may not come back.
SOLD_LOOKBACK_DAYS=365

# Android app (Capacitor): the hosted server the APK loads. Used only at build time.
CAP_SERVER_URL=

# Discogs price guide, a second price source for collectible CDs (Auto tab).
# Personal access token from https://www.discogs.com/settings/developers (free).
# Per-condition price suggestions need your Discogs seller settings filled in.
DISCOGS_TOKEN=
